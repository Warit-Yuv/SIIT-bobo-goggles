<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>m1_control</name>
  <version>1.0.0</version>
  <description>
    Multi-modal teleoperation overlay for the Yahboom ROSMASTER M1.
    Provides a central safety arbiter (watchdog + mode multiplexer), keyboard
    mecanum/PTZ teleop, gaze HUD controller, EEG UDP bridge and a compressed
    image throttler. Layer 4 of the workspace stack - no vendor files touched.
  </description>
  <maintainer email="pi@raspberrypi.local">ROSMASTER M1 Team</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <!-- The operator console draws a live SLAM map, so it needs the map
       message and TF lookups. Both are standard Humble packages. -->
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <!-- The bringup launches our own EKF parameter file (config/ekf_m1.yaml)
       instead of the vendor one, so robot_localization is a direct
       dependency now rather than something inherited from the vendor stack. -->
  <exec_depend>robot_localization</exec_depend>

  <!-- Only required on the robot (arbiter publishes yahboomcar_msgs/ServoControl).
       Imported lazily so the same package also builds on the operator PC. -->
  <exec_depend>yahboomcar_msgs</exec_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <!-- sensor_sync_node (operator PC only) -->
  <exec_depend>message_filters</exec_depend>

  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
