<?xml version="1.0" encoding="UTF-8" ?>
<!--
  CycloneDDS configuration for the ROSMASTER M1 (Raspberry Pi 5).

  Used by BOTH machines. Running the same RMW implementation on each side is
  not cosmetic: /tf_static is published with TRANSIENT_LOCAL durability, and
  that QoS is not reliably delivered across different DDS vendors. With the Pi
  on FastDDS and the operator PC on CycloneDDS, /tf arrived at 20 Hz but
  /tf_static never did - so slam_toolbox could not transform the scans and
  silently produced no map at all.

  SocketReceiveBufferSize is the important setting. A 640x480 JPEG arrives as
  many UDP fragments; the DDS must hold all of them while reassembling. The
  kernel ceiling is raised separately (scripts/tune_network.sh); this asks
  Cyclone to actually use a large buffer. 10 MB is comfortably inside the
  16 MB net.core.rmem_max on this robot.
-->
<CycloneDDS xmlns="https://cdds.io/config">
    <Domain id="any">
        <General>
            <!-- Let Cyclone pick the active interface (wlan0 on the Pi,
                 ens33 on the VM). The older NetworkInterfaceAddress element is
                 deprecated and warns on every node start. -->
            <Interfaces>
                <NetworkInterface autodetermine="true"/>
            </Interfaces>
            <AllowMulticast>true</AllowMulticast>
            <!-- Explicit "B" unit: a bare number is deprecated and warns on
                 every node start. 65500 B stays under a typical 64 KiB
                 datagram ceiling while leaving room for RTPS headers. -->
            <MaxMessageSize>65500B</MaxMessageSize>
        </General>
        <Internal>
            <SocketReceiveBufferSize min="10MB"/>
        </Internal>
    </Domain>
</CycloneDDS>
